# Configuration priority: CLI > process environment > .env > defaults.
AUTOINDEX_DIRECTORY=.
AUTOINDEX_BIND=0.0.0.0
AUTOINDEX_PORT=6701
AUTOINDEX_README=true
AUTOINDEX_INDEX_FILES=index.html,index.htm
AUTOINDEX_PAGE_SIZE=100
AUTOINDEX_TIMEZONE=Asia/Shanghai
AUTOINDEX_LOG_LEVEL=info
AUTOINDEX_ALLOW_SENSITIVE_PATHS=false
