cache-control: private, no-store
content-security-policy: default-src 'none'; style-src 'unsafe-inline'; script-src 'sha256-<HASH>'; script-src-attr 'none'; img-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
content-type: text/html; charset=utf-8
referrer-policy: no-referrer
x-content-type-options: nosniff
x-frame-options: DENY
